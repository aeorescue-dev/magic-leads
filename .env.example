# ============================================================
# GARIMPADOR DE LEADS — CUSTO $0 (SQLite + Vercel)
# Nenhuma variável abaixo é obrigatória para o MVP funcionar.
# ============================================================

# --- Backend (config.py) ---
# DEBUG=True para desenvolvimento
DEBUG=True

# Opcional: SCRAPER_KEYWORDS (separadas por vírgula). Filtra complaint types do 311.
# Inclui mato alto, entulho, lixo, vegetação + obras (roof/structure/plumbing/paint).
SCRAPER_KEYWORDS=Roof,Grass,Overgrown,Weed,Vegetation,Litter,Garbage,Trash,Debris,Unsanitary,Dirty,Plumbing,Paint,Structure

# Opcional (futuro multi-tenant): credenciais Supabase — NÃO usadas no MVP SQLite.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional (fase de monetização): chaves Stripe — pagamento AVULSO de 7 dias
# (mode=payment, currency=usd). NÃO é assinatura recorrente.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=price_...

# --- Persistência SQLite (Railway) ---
# Em produção, monte um volume em /data e deixe DATA_DIR=/data (já no Dockerfile).
# Sem volume, o SQLite é apagado a cada redeploy.
# Prioridade: LEADS_DB_PATH > DATA_DIR/leads.db > data/leads.db (dev local).
# LEADS_DB_PATH=/data/leads.db
# DATA_DIR=/data

# --- Rotas administrativas ---
# Header X-Admin-Secret exigido por requalify/enrich-all/push-test.
# Se vazio, TODAS as rotas admin são negadas (fail-closed).
ADMIN_SECRET=

# --- Cron (GitHub Actions / Railway) ---
# Header X-Cron-Secret exigido por /api/scraper/run e /api/cron/expire-holds.
CRON_SECRET=

# --- Frontend (frontend/.env.local) ---
# Em produção, o frontend chama /api/leads relativo (mesmo domínio), sem env.
# Em dev local, aponte para o backend:
# NEXT_PUBLIC_API_URL=http://localhost:8000
